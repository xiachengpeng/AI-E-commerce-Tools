# 复制此文件为 .env 并填入你的实际配置
# Copy this file to .env and fill in your actual values

# Firecrawl 爬虫服务（默认使用官方云端接口，亦可切换为本地自建地址）
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1/scrape
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# AI 路由首次启动默认配置：仅当本地 SQLite 中尚不存在任何 AI 提供商记录时导入。
# 之后“设置”页面中的提供商和文本/图片绑定优先；修改本文件不会覆盖已保存的设置。

# 默认线路：gemini 或 vertex
AI_PROVIDER=gemini

# Google Gemini API Key（AI_PROVIDER=gemini 时使用）
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 模型 ID（首次导入的文本默认模型）
GEMINI_MODEL_ID=gemini-3.1-pro-preview

# 可选：首次导入时分别覆盖文本和图片模型；未设置时使用 GEMINI_MODEL_ID 和内置图片模型默认值。
FRONTEND_TEXT_MODEL=
FRONTEND_IMAGE_MODEL=

# Vertex AI（AI_PROVIDER=vertex 时使用）
VERTEX_PROJECT_ID=your_vertex_project_id
VERTEX_LOCATION=global
VERTEX_KEY_PATH=/absolute/path/to/service-account.json
